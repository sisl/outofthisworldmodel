# Copy to .env (gitignored) and fill in. All values are read at entry-point
# startup via python-dotenv; hydra configs reference them with ${oc.env:...}.

# --- Hugging Face ---
# Token with write access for model upload (or rely on `huggingface-cli login`)
HF_TOKEN=
# Model repo trained RL/WM models upload to
OWM_HF_MODEL_REPO=sislaboratory/owm-models
# Training/comparison dataset (environments=from_dataset reads its env config)
OWM_HF_DATASET_REPO=sislaboratory/owm-iss-coop-goal-dt50ms

# --- Weights & Biases ---
# API key (or rely on `wandb login`)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
# online | offline | disabled
WANDB_MODE=online

# --- Compute ---
# CUDA devices this checkout may use, as the comma-separated indices
# nvidia-smi prints (the justfile pins CUDA_DEVICE_ORDER=PCI_BUS_ID so the two
# agree). Recipes that place work on a card read this, and sweep-fleet
# round-robins its agents over the list. Defaults to 0.
OWM_GPUS=0
# Render adapter, matched as a substring of the adapter summary. Vulkan does
# not honour CUDA_VISIBLE_DEVICES, so this is the only way to steer the
# renderer, and OWM_GPUS has no effect on it. Leave empty on a machine whose
# cards are all yours: pygfx then asks for a high-performance adapter and lands
# on a discrete GPU. Set it on a shared host to keep the renderer off someone
# else's card. `just adapters` lists the candidates.
PYGFX_WGPU_ADAPTER_NAME=
