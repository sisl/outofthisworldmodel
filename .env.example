# Copy to .env (gitignored) and fill in. All values are read at entry-point
# startup via python-dotenv; hydra configs reference them with ${oc.env:...}.

# --- Hugging Face ---
# Token with write access for model upload (or rely on `huggingface-cli login`)
HF_TOKEN=
# Model repo trained RL/WM models upload to
OWM_HF_MODEL_REPO=sislaboratory/owm-models
# Training/comparison dataset (environments=from_dataset reads its env config)
OWM_HF_DATASET_REPO=sislaboratory/owm-iss-coop-goal-dt50ms

# --- Weights & Biases ---
# API key (or rely on `wandb login`)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
# online | offline | disabled
WANDB_MODE=online
